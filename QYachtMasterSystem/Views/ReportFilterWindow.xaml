<Window x:Class="QYachtMaster.Views.ReportFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Report / تصدير التقرير" 
        Height="360" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="📊 Export Detailed Report / تصدير التقرير التفصيلي"
                   Style="{StaticResource TitleBlockStyle}" Margin="0,0,0,20"/>

        <!-- Mode Toggle -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton x:Name="RbMonthly" Content="Monthly Period / شهري" IsChecked="True"
                         Checked="OnModeChanged" FontSize="13" Margin="0,0,20,0"
                         Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
            <RadioButton x:Name="RbCustom" Content="Custom Date Range / نطاق مخصص"
                         Checked="OnModeChanged" FontSize="13"
                         Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Monthly Panel -->
        <Grid x:Name="PanelMonthly" Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Select Month / اختر الشهر:" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
            <ComboBox x:Name="PeriodCombo" Grid.Column="1" VerticalAlignment="Center" Height="34" FontSize="14"/>
        </Grid>

        <!-- Custom Date Range Panel -->
        <Grid x:Name="PanelCustom" Grid.Row="3" Margin="0,0,0,15" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date / من تاريخ:" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,0,0,10"/>
            <DatePicker x:Name="DpFrom" Grid.Row="0" Grid.Column="1" Height="34" FontSize="13" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="To Date / إلى تاريخ:" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
            <DatePicker x:Name="DpTo" Grid.Row="1" Grid.Column="1" Height="34" FontSize="13"/>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel / إلغاء" Click="OnCancelClick" Margin="0,0,12,0"
                    Padding="18,8" Background="{DynamicResource DangerBrush}" Foreground="White"/>
            <Button Content="📤 Export / تصدير" Click="OnExportClick" Padding="22,8"
                    FontWeight="Bold" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
