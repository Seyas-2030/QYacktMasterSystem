<Window x:Class="QYachtMaster.Views.ExcelSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Parts Synchronization / مزامنة قطع الغيار" 
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Description -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Stock Sync &amp; New Parts Confirmation / مزامنة المخزن وتأكيد القطع الجديدة" 
                       Style="{StaticResource TitleBlockStyle}"/>
            <TextBlock Text="Unrecognized parts found in spreadsheet. Select which items to import as new database profiles:" 
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0"/>
            <TextBlock Text="تم العثور على قطع غيار غير مسجلة في قاعدة البيانات. حدد القطع التي ترغب في إضافتها للمخزن:" 
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
        </StackPanel>

        <!-- New Parts List DataGrid -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5" Margin="0,0,0,15">
            <DataGrid VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" x:Name="NewPartsGrid" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="32">
                <DataGrid.Columns>
                    <!-- Import Checkbox -->
                    <DataGridCheckBoxColumn Header="Import / استيراد" Binding="{Binding IsSelectedToImport, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    
                    <!-- Part No -->
                    <DataGridTextColumn Header="Part No / رقم القطعة" Binding="{Binding PartNo}" IsReadOnly="True" Width="120"/>

                    <!-- Category -->
                    <DataGridTextColumn Header="Category / الصنف" Binding="{Binding Category}" IsReadOnly="True" Width="100"/>

                    <!-- Quantity in Excel -->
                    <DataGridTextColumn Header="Excel Qty / الكمية" Binding="{Binding QtyInExcel}" IsReadOnly="True" Width="100"/>

                    <!-- SEAL adjustment -->
                    <DataGridTextColumn Header="Sales Adjust / مبيعات" Binding="{Binding SealValue}" IsReadOnly="True" Width="100"/>

                    <!-- Final Calculated Qty -->
                    <DataGridTextColumn Header="Final Qty / الرصيد النهائي" Binding="{Binding CalculatedQty}" IsReadOnly="True" Width="100"/>

                    <!-- Location -->
                    <DataGridTextColumn Header="Location / الموقع" Binding="{Binding Location}" IsReadOnly="True" Width="100"/>

                    <!-- Car Model -->
                    <DataGridTextColumn Header="Compatibility / الموديل" Binding="{Binding CarModel}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Button Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" Grid.Column="0" Text="Existing parts will be updated in the background automatically / سيتم تحديث القطع الحالية في الخلفية تلقائياً." 
                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Start Update &amp; Import / بدء التحديث والمزامنة" Click="OnStartSyncClick" Padding="20,10" FontWeight="Bold"/>
            </Grid>
        </Border>

    </Grid>
</Window>
