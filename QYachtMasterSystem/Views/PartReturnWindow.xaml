<Window x:Class="QYachtMaster.Views.PartReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Return Part / استرجاع قطعة"
        Height="700" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Input TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A7EDB"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <!-- Generic button style -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header banner -->
            <RowDefinition Height="Auto"/>
            <!-- Customer info -->
            <RowDefinition Height="Auto"/>
            <!-- Part + Invoice fields -->
            <RowDefinition Height="Auto"/>
            <!-- Qty + Price + Refund -->
            <RowDefinition Height="Auto"/>
            <!-- Refund type -->
            <RowDefinition Height="Auto"/>
            <!-- Notes -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
            <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ HEADER BANNER ════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#C0392B" CornerRadius="8"
                Padding="18,14" Margin="0,0,0,18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="🔁  Return Part / استرجاع قطعة"
                               FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Locked Invoice — Refund &amp; Restock Workflow"
                               FontSize="11" Foreground="#FFBDBD" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="فاتورة مقفلة — إرجاع المبلغ وإعادة القطعة للمخزون"
                           FontSize="11" Foreground="#FFBDBD"
                           VerticalAlignment="Bottom"/>
            </DockPanel>
        </Border>

        <!-- ═══════════════ CUSTOMER DISPLAY ═════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👤  Customer / العميل: " FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                <TextBlock Text="{Binding CustomerDisplay}"
                           Foreground="#2980B9" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════ PART NO + INVOICE NO ═════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Part No -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Part No / رقم القطعة *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             x:Name="PartNoBox"
                             Text="{Binding PartNo, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="🔍" ToolTip="Lookup / بحث"
                            Command="{Binding LookupPartCommand}"
                            Background="#2980B9" Foreground="White"
                            Padding="10,8" Margin="6,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- Invoice No (optional) -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Invoice No (optional) / رقم الفاتورة" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="e.g.  INV-2026-1001"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ QTY + UNIT PRICE + REFUND TOTAL ══════════════ -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Qty -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Qty to Return / الكمية *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding QtyReturned, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F1}'}"
                         IsEnabled="{Binding PartFound}"/>
            </StackPanel>

            <!-- Unit Price -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Unit Price (QAR) / سعر الوحدة" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"
                         IsEnabled="{Binding PartFound}"/>
            </StackPanel>

            <!-- Refund Amount (auto-calculated, read-only display) -->
            <StackPanel Grid.Column="4">
                <TextBlock Text="Refund Total (QAR) / إجمالي الاسترداد" Style="{StaticResource FieldLabel}"/>
                <Border Background="#F0FFF4" BorderBrush="#27AE60" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <TextBlock Text="{Binding RefundAmount, StringFormat='{}{0:F2} QAR'}"
                               FontSize="14" FontWeight="Bold" Foreground="#1E8449"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ REFUND TYPE ═══════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Refund Type / نوع الاسترداد:"
                           Style="{StaticResource SectionHeader}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Cash option -->
                    <Border x:Name="CashBorder"
                            CornerRadius="6" Padding="14,8" Margin="0,0,10,0"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#ECEFF1"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=CashRadio, Path=IsChecked}" Value="True">
                                        <Setter Property="BorderBrush" Value="#2980B9"/>
                                        <Setter Property="Background" Value="#EBF5FB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton x:Name="CashRadio"
                                     Content="💵  Cash Refund / استرداد نقدي"
                                     GroupName="RefundTypeGroup"
                                     IsChecked="True"
                                     FontSize="13" FontWeight="SemiBold"
                                     Foreground="#1A252F"
                                     Checked="CashRadio_Checked"/>
                    </Border>
                    <!-- Debt reduction option -->
                    <Border x:Name="DebtBorder"
                            CornerRadius="6" Padding="14,8"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#ECEFF1"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=DebtRadio, Path=IsChecked}" Value="True">
                                        <Setter Property="BorderBrush" Value="#27AE60"/>
                                        <Setter Property="Background" Value="#E8F8F5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton x:Name="DebtRadio"
                                     Content="📉  Reduce Debt / خصم من الدين"
                                     GroupName="RefundTypeGroup"
                                     FontSize="13" FontWeight="SemiBold"
                                     Foreground="#1A252F"
                                     Checked="DebtRadio_Checked"/>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ NOTES ═════════════════════════════════════════ -->
        <StackPanel Grid.Row="5" Margin="0,0,0,14">
            <TextBlock Text="Notes / ملاحظات الموظف (optional)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     Height="62" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" Padding="10,8"/>
        </StackPanel>

        <!-- ═══════════════ STATUS BAR ════════════════════════════════════ -->
        <Border Grid.Row="6"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="#FDEDEC"/> <!-- Light Red background for error by default -->
                    <Setter Property="BorderBrush" Value="#E74C3C"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMsg}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PartFound}" Value="True">
                            <Setter Property="Background" Value="#EBF5FB"/> <!-- Light Blue background on success -->
                            <Setter Property="BorderBrush" Value="#2980B9"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMsg}"
                       FontWeight="Bold" FontSize="12" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#C0392B"/> <!-- Red text for error by default -->
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PartFound}" Value="True">
                                <Setter Property="Foreground" Value="#27AE60"/> <!-- Green/Blue text on success -->
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>


        <!-- ═══════════════ ACTION BUTTONS ═══════════════════════════════ -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cancel -->
            <Button Grid.Column="0"
                    Content="✖  Cancel / إلغاء"
                    Background="#BDC3C7" Foreground="#2C3E50"
                    Click="OnCancelClick"
                    Padding="0,12" FontSize="14"/>

            <!-- Confirm Return -->
            <Button Grid.Column="2"
                    Content="✅  Confirm Return / تأكيد الاسترجاع"
                    Background="#C0392B" Foreground="White"
                    Command="{Binding ConfirmReturnCommand}"
                    Padding="0,12" FontSize="14" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
