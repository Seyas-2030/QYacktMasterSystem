<Window x:Class="QYachtMaster.Views.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="CurrentWindow"
        Title="Smart Invoicing &amp; Billing / نظام الفواتير الذكي - Q-Yacht Master" 
        Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Status Lock Bar -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="6" Padding="15,10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Q-Yacht Master Smart Invoicing System / نظام كيو ياخت ماستر الذكي للفواتير" 
                           FontSize="16" FontWeight="Bold" Foreground="{DynamicResource HeaderForegroundBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding LockStatusText}" 
                           FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Metadata Info Grid -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <Grid IsEnabled="{Binding IsEditable}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="Invoice No / رقم الفاتورة:" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,10,10">
                    <TextBlock Text="Date / تاريخ الفاتورة:" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding InvoiceDate, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,10,10">
                    <TextBlock Text="Customer / العميل:" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding CustomerName, Mode=OneWay}" IsReadOnly="True" Background="#F8ECEE"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="10,0,0,10">
                    <TextBlock Text="Phone / الهاتف:" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding MobilePhone}" IsReadOnly="True" Background="#F8ECEE"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,5,0,0">
                    <TextBlock Text="Vehicle Details / بيانات السيارة:" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding VehicleDetails, Mode=OneWay}" IsReadOnly="True" Background="#F8ECEE"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Primary DataGrid for Line Items -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15">
            <DataGrid VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding InvoiceLines}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="Transparent"
                      BorderThickness="0"
                      IsEnabled="{Binding IsEditable}"
                      RowHeight="32">
                <DataGrid.Columns>
                    <!-- Description -->
                    <DataGridTextColumn Header="Description / البيان" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    
                    <!-- Qty -->
                    <DataGridTextColumn Header="Qty / الكمية" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F1}'}" Width="80"/>
                    
                    <!-- Unit Price -->
                    <DataGridTextColumn Header="Unit Price (QAR) / أجر الوحدة" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}" Width="150"/>
                    
                    <!-- Price x Qty -->
                    <DataGridTextColumn Header="Price × Qty / السعر × الكمية" Binding="{Binding QtySubTotal, StringFormat='{}{0:F2}'}" IsReadOnly="True" Width="150"/>
                    
                    <!-- Discount -->
                    <DataGridTextColumn Header="Discount (QAR) / الخصم" Binding="{Binding Discount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}" Width="120"/>
                    
                    <!-- Discount Notes -->
                    <DataGridTextColumn Header="Discount Notes / ملاحظات الخصم" Binding="{Binding DiscountNotes, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                    
                    <!-- Final Line Total -->
                    <DataGridTextColumn Header="Final Total / الإجمالي النهائي" Binding="{Binding FinalLineTotal, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}" Width="150"/>
 
                    <!-- Warranty -->
                    <DataGridTemplateColumn Header="Warranty / الضمان" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Warranty}" VerticalAlignment="Center" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox SelectedValue="{Binding Warranty, UpdateSourceTrigger=PropertyChanged}" 
                       SelectedValuePath="Content">
                                    <ComboBoxItem Content="3 Months / 3 أشهر"/>
                                    <ComboBoxItem Content="12 Months / 12 شهر"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Action: Remove line -->
                    <DataGridTemplateColumn Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="حذف / ✕" 
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="#E74C3C" Foreground="White" Padding="4,2" FontSize="10"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Low Stock Alerts Panel (Module 4) -->
        <Border Grid.Row="3" Background="{DynamicResource WarningBannerBrush}" 
                BorderBrush="{DynamicResource WarningBorderBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15"
                Visibility="{Binding HasStockWarning, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StockWarningMessage}" Foreground="{DynamicResource WarningTextBrush}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer Summary Panel & Controls -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Bottom Left Actions -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsEditable}">
                <Button Content="➕ Add Line / إضافة سطر" Command="{Binding AddCustomLineCommand}" Margin="0,0,10,0" Padding="15,10"/>
                <Button Content="📂 Import Excel / استيراد بنود" Command="{Binding ImportExcelCommand}" Padding="15,10"/>
            </StackPanel>

            <!-- Bottom Right Financial Grid -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Sub Total -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sub-Total / الإجمالي الفرعي:" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubTotal, StringFormat='{}{0:F2} QAR'}" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" Margin="0,5"/>

                    <!-- Row 1: Total Discounts -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Discounts Total / إجمالي الخصم:" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalDiscounts, StringFormat='{}{0:F2} QAR'}" TextAlignment="Right" Foreground="{DynamicResource DangerBrush}" Margin="0,5"/>

                    <!-- Row 2: Labor Fees -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Labor Fees (QAR) / أجور اليد:" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LaborTotal, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}" HorizontalContentAlignment="Right" Margin="0,5" Width="150" HorizontalAlignment="Right" IsEnabled="{Binding IsEditable}"/>

                    <!-- Row 3: Previous Debt (Read-only) -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Previous Debt / الدين السابق:" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviousDebt, StringFormat='{}{0:F2} QAR'}" TextAlignment="Right" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" Margin="0,5"/>

                    <!-- Row 4: Debt Payment (Installment input) -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Pay from Previous Debt (QAR) / سداد من الدين السابق:" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DebtPayment, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}" HorizontalContentAlignment="Right" Margin="0,5" Width="150" HorizontalAlignment="Right" IsEnabled="{Binding IsEditable}"/>

                    <!-- Row 5: Grand Total / Paid -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,5">
                        <TextBlock Text="Grand Total / المبلغ الإجمالي:" Foreground="{DynamicResource PrimaryButtonBrush}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text=" | Paid / المدفوع:" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="5" Grid.Column="1" Margin="0,10,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding GrandTotal, StringFormat='{}{0:F2} QAR'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryButtonBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}" Width="100" HorizontalContentAlignment="Right" IsEnabled="{Binding IsEditable}"/>
                    </Grid>

                    <!-- Row 6: Balance Due & Issue Invoice -->
                    <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,10,0,0">
                        <TextBlock Text="Balance Due (Debt) / المبلغ المتبقي (الدين):" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding BalanceDue, StringFormat='{}{0:F2} QAR'}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="18"/>
                    </StackPanel>
                    
                    <Button Grid.Row="6" Grid.Column="1" Content="🖨️ Issue &amp; Print / إصدار وطباعة" 
                            Command="{Binding SaveAndPrintCommand}"
                            CommandParameter="{Binding ElementName=CurrentWindow}"
                            Padding="20,10" FontWeight="Bold" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                            Background="{DynamicResource PrimaryButtonBrush}"
                            Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
