<Window x:Class="QYachtMaster.Views.ExcelColumnMapperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Import Column Mapping / مطابقة أعمدة الاستيراد" 
        Height="350" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Match the Excel File Columns / طابق الأعمدة المناسبة في ملف الإكسل" 
                    Style="{StaticResource TitleBlockStyle}" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Part Number Column Selection -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Part Number Column / رقم القطعة: *" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,5"/>
            <ComboBox x:Name="PartNoCombo" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

            <!-- Qty Column Selection -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Quantity Column / الكمية: *" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,5"/>
            <ComboBox x:Name="QtyCombo" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

            <!-- Sale Price Column Selection -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sale Price Column / سعر البيع:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,5"/>
            <ComboBox x:Name="SalePriceCombo" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

            <!-- Description Column Selection -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description Column / الوصف:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,5"/>
            <ComboBox x:Name="DescriptionCombo" Grid.Row="3" Grid.Column="1" Margin="0,5"/>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel / إلغاء" Click="OnCancelClick" Margin="0,0,10,0" Padding="15,7" Background="{DynamicResource DangerBrush}"/>
            <Button Content="Import / استيراد" Click="OnImportClick" Padding="20,7" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
